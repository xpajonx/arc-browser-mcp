{
  "name": "arc-browser-mcp-server",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "A local stdio MCP server for safe URL navigation in the running Windows Arc Browser.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xpajonx/arc-browser-mcp.git"
  },
  "homepage": "https://github.com/xpajonx/arc-browser-mcp#readme",
  "bugs": {
    "url": "https://github.com/xpajonx/arc-browser-mcp/issues"
  },
  "keywords": [
    "opencode",
    "mcp",
    "arc-browser",
    "windows",
    "wsl2"
  ],
  "main": "dist/src/index.js",
  "files": [
    "dist",
    "execution",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "eval": "npm run build && node evals/run.mjs",
    "test:live": "npm run build && node tests/live-smoke.mjs",
    "start": "node dist/src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
